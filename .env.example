# The ONLY variables the browser bundle may use. Both are safe to expose.
# Copy this file to .env for local development. Never add a service-role key or
# any GitHub App value here: anything prefixed VITE_ ends up in the public bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
