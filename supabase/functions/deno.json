{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100
  },
  "tasks": {
    "check": "deno check */index.ts",
    "test": "deno test --allow-env --allow-read",
    "lint": "deno lint"
  }
}
