          "props": {
            "doc": {
              "content": [
                {
                  "content": [
                    {
                      "text": "To qualify for the ISA Certified Arborist Exam, you must be able to document one of the following:",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "type": "doc"
            }
          },
          "style": {},
          "type": "text"
